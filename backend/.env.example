# Copy to .env and fill in. Never commit .env.
ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+psycopg://unifix:CHANGE_ME@localhost:5432/unifix_dev
# Used only by the test suite (it is migrated and truncated by tests).
TEST_DATABASE_URL=postgresql+psycopg://unifix:CHANGE_ME@localhost:5432/unifix_test

# At least 32 random bytes, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-bytes

# Comma-separated, explicit origins only (no wildcard). The frontend must be same-site with the API.
CORS_ORIGINS=http://localhost:3000
# false only for plain-http local development; production refuses to start with false.
COOKIE_SECURE=false

FRONTEND_BASE_URL=http://localhost:3000

# console (development/test only) | smtp (any provider)
EMAIL_BACKEND=console
EMAIL_FROM="UniFix <no-reply@localhost>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS_MODE=starttls

# --- Stellar TESTNET escrow (STELLAR_ESCROW_DESIGN). Leave ESCROW_CONTRACT_ID unset to disable payments.
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Escrow deployment holding Circle testnet USDC (deployed 2026-11-17; wasm sha256
# 39fa48c797795dc67915fbfdfd0b407aa8287d4e5d2f92863c1744dac209d45e). Public identifier, not a secret.
# ESCROW_CONTRACT_ID=CD5ARDVPAQ26SL7BZHLOKAG2T4CBAAQN47Y2QEPX2KEGSJZYAX2JQVHG
ESCROW_TOKEN_CODE=USDC
ESCROW_TOKEN_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
ESCROW_TOKEN_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Must match the contract's review window (checked at startup).
ESCROW_REVIEW_WINDOW_SECONDS=259200
# >= 32 random bytes; derives escrow ids. Never change it once escrows exist.
# ESCROW_ID_SECRET=
# The operator co-signs fund() only. Env only: never logged, returned or stored.
# STELLAR_OPERATOR_ADDRESS=G...
# STELLAR_OPERATOR_SECRET=S...
# D14: fixed demo rate, fiat major units per 1 token; refused on any network other than TESTNET.
FX_DEMO_RATE_NGN=1650.00000000
# FX_DEMO_RATE_GHS=
# Contract build unit: 86400 (production). 60 only with the short-windows test build.
ESCROW_DEADLINE_UNIT_SECONDS=86400
# Reconciler and keeper: every API process runs one; a PostgreSQL advisory lock elects the leader.
# The lock needs a direct (non-pooled) connection: DATABASE_URL must bypass PgBouncer transaction pooling.
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_SECONDS=5
KEEPER_DELAY_SECONDS=900
