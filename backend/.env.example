# Copy to .env and fill in. Never commit .env.
ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+psycopg://unifix:CHANGE_ME@localhost:5432/unifix_dev
# Used only by the test suite (it is migrated and truncated by tests).
TEST_DATABASE_URL=postgresql+psycopg://unifix:CHANGE_ME@localhost:5432/unifix_test

# At least 32 random bytes, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-bytes

# Comma-separated, explicit origins only (no wildcard). The frontend must be same-site with the API.
CORS_ORIGINS=http://localhost:3000
# false only for plain-http local development; production refuses to start with false.
COOKIE_SECURE=false

FRONTEND_BASE_URL=http://localhost:3000

# console (development/test only) | smtp (any provider)
EMAIL_BACKEND=console
EMAIL_FROM="UniFix <no-reply@localhost>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS_MODE=starttls
